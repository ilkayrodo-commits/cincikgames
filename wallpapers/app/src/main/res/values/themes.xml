<resources>
    <style name="Theme.CincikDuvar" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FF7A45</item>
        <item name="colorAccent">#FF7A45</item>
        <item name="android:windowBackground">#0E0F14</item>
        <item name="android:statusBarColor">#0E0F14</item>
        <item name="android:navigationBarColor">#0E0F14</item>
    </style>
    <style name="Theme.CincikDuvar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
